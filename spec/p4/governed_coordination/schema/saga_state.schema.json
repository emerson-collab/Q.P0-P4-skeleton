{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "change_set_ref": {
      "minLength": 1,
      "type": "string"
    },
    "execution_phase": {
      "enum": [
        "CANDIDATE",
        "TRIAL_ACTIVATION",
        "EVALUATION_WAIT",
        "FINAL_ACTIVATION",
        "COMPENSATION",
        "ROLLBACK",
        null
      ]
    },
    "fencing_token": {
      "minLength": 1,
      "type": "string"
    },
    "journal_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "lease_epoch": {
      "type": "integer"
    },
    "plan_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "recovery_cursor": {
      "anyOf": [
        {
          "$ref": "recovery_cursor.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "saga_state": {
      "enum": [
        "PROPOSED",
        "IMPACT_READY",
        "EXECUTING",
        "CANDIDATES_READY",
        "VALIDATED",
        "PLAN_APPROVED",
        "ACTIVE",
        "RECOVERY_REQUIRED",
        "ROLLED_BACK",
        "FROZEN"
      ]
    },
    "updated_at": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "change_set_ref",
    "saga_state",
    "execution_phase",
    "plan_ref",
    "journal_ref",
    "recovery_cursor",
    "lease_epoch",
    "fencing_token",
    "updated_at"
  ],
  "title": "P4 Saga State",
  "type": "object"
}
