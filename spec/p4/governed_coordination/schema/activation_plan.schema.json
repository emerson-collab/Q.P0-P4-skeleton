{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "activation_plan_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "activation_plan_ref": {
      "minLength": 1,
      "type": "string"
    },
    "change_set_ref": {
      "minLength": 1,
      "type": "string"
    },
    "compensation_plan_ref": {
      "minLength": 1,
      "type": "string"
    },
    "ordered_step_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "recovery_policy_ref": {
      "minLength": 1,
      "type": "string"
    },
    "steps": {
      "items": {
        "$ref": "activation_plan_step.schema.json"
      },
      "minItems": 1,
      "type": "array"
    },
    "verified_impact_graph_ref": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "activation_plan_ref",
    "activation_plan_hash",
    "change_set_ref",
    "verified_impact_graph_ref",
    "ordered_step_refs",
    "compensation_plan_ref",
    "recovery_policy_ref",
    "steps"
  ],
  "title": "P4 Activation Plan",
  "type": "object"
}
