{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "change_set_ref": {
      "minLength": 1,
      "type": "string"
    },
    "coordination_receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "entry_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "execution_phase": {
      "type": [
        "string",
        "null"
      ]
    },
    "previous_entry_hash": {
      "type": [
        "string",
        "null"
      ]
    },
    "provider_receipt_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "recorded_at": {
      "minLength": 1,
      "type": "string"
    },
    "recovery_cursor": {
      "anyOf": [
        {
          "$ref": "recovery_cursor.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "request_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "sequence": {
      "type": "integer"
    },
    "state_after": {
      "enum": [
        "PROPOSED",
        "IMPACT_READY",
        "EXECUTING",
        "CANDIDATES_READY",
        "VALIDATED",
        "PLAN_APPROVED",
        "ACTIVE",
        "RECOVERY_REQUIRED",
        "ROLLED_BACK",
        "FROZEN"
      ]
    },
    "state_before": {
      "enum": [
        "PROPOSED",
        "IMPACT_READY",
        "EXECUTING",
        "CANDIDATES_READY",
        "VALIDATED",
        "PLAN_APPROVED",
        "ACTIVE",
        "RECOVERY_REQUIRED",
        "ROLLED_BACK",
        "FROZEN"
      ]
    },
    "step_ref": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "sequence",
    "previous_entry_hash",
    "entry_hash",
    "change_set_ref",
    "state_before",
    "state_after",
    "execution_phase",
    "step_ref",
    "request_hash",
    "provider_receipt_ref",
    "coordination_receipt_ref",
    "recovery_cursor",
    "recorded_at"
  ],
  "title": "P4 Saga Journal Entry",
  "type": "object"
}
