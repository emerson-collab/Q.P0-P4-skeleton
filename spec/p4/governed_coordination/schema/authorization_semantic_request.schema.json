      "minLength": 1,
      "type": "string"
    },
    "active_pointer_ref": {
      "minLength": 1,
      "type": "string"
    },
    "approval_ref": {
      "minLength": 1,
      "type": "string"
    },
    "candidate_ref": {
      "minLength": 1,
      "type": "string"
    },
    "change_set_ref": {
      "minLength": 1,
      "type": "string"
    },
    "evaluation_ref": {
      "minLength": 1,
      "type": "string"
    },
    "expected_active_version": {
      "minLength": 1,
      "type": "string"
    },
    "fencing_token": {
      "minLength": 1,
      "type": "string"
