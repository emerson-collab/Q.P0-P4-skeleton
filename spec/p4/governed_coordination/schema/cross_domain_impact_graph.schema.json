{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "edges": {
      "items": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "additionalProperties": false,
        "properties": {
          "resolved": {
            "type": "boolean"
          },
          "source_domain_ref": {
            "minLength": 1,
            "type": "string"
          },
          "source_hash": {
            "pattern": "^sha256:[0-9a-f]{64}$",
            "type": "string"
          },
          "source_ref": {
            "minLength": 1,
            "type": "string"
          },
          "target_domain_ref": {
            "minLength": 1,
            "type": "string"
          }
        },
        "required": [
          "source_domain_ref",
          "target_domain_ref",
          "source_ref",
          "source_hash",
          "resolved"
        ],
        "title": "P4 Impact Edge",
        "type": "object"
      },
      "type": "array"
    },
    "target_domain_refs": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "type": "array",
      "uniqueItems": true
    },
    "verified_impact_graph_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "verified_impact_graph_ref": {
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "verified_impact_graph_ref",
    "verified_impact_graph_hash",
    "target_domain_refs",
    "edges"
  ],
  "title": "P4 Cross Domain Impact Graph",
  "type": "object"
}
