projection:
  source_contract_ref: Q.SS.STD.P4.CONTRACT.COORDINATION@V0140
  source_contract_hash: sha256:1ab47644388f9270415abc96b565ce0e589a813d9634ba5be4ebf75c0f39865b
  semantic_authority: false
  projection_only: true
object_model:
  hierarchy:
  - DOMAIN
  - CAPABILITY
  - OPERATION
  domain_ref: q.p4.domain.cross_domain_coordination
  capability_ref: q.p4.capability.governed_coordination
  management_operation_ids:
  - inspect_change_set
  - approve_activation_plan
  - resume_recovery
  - freeze_change_set
  p3_client_port_ref: q.p3.port.coordination_contract
  module_object_forbidden: true
  interface_is_operation_owned_formal_object_not_hierarchy_level: true
  port_is_binding_object_not_business_hierarchy_level: true
coordination_kernel:
  change_set:
    immutable_after_plan_approval: true
    minimum_domain_count: 1
    single_domain_routes_to: ROUTE_BY_ROOT_CONTRACT_CLASS
    required_semantics:
    - change_set_ref
    - change_set_hash
    - evolution_case_refs
    - root_contract_class
    - changed_stable_contract_q_id
    - previous_exact_contract_ref
    - previous_contract_hash
    - current_exact_contract_ref
    - current_contract_hash
    - target_domain_refs
    - predicted_impact_graph_ref
    - domain_objectives
    - success_metric_refs
    - risk_ref
    per_domain_required_semantics:
    - target_domain_ref
    - change_ref
    - expected_active_version
    - candidate_ref
    - candidate_hash
    - domain_state_ref
    - local_approval_ref
    - verified_impact_graph_ref
    duplicate_domain_forbidden: true
    complete_domain_state_reference_required: true
    partial_patch_target_forbidden: true
    hash_covers_all_semantic_fields: true
    case_intake_before_enrichment_allowed: true
    pre_impact_enrichment_required_semantics:
    - rule_delta_ref
    - rule_delta_hash
    - q_prompt_artifact_ref
    - q_prompt_artifact_hash
    - reverse_dependency_fact_set_ref
    - reverse_dependency_fact_set_hash
    - changed_leaf_hash_set_ref
    - changed_leaf_hash_set_hash
    routing:
      BUSINESS_DOMAIN_CONTRACT: P3
      CAPABILITY_CONTRACT: P3
      META_STANDARD_CONTRACT: P4
      P0_STAGE_STANDARD_CONTRACT: P4
      P1_STAGE_STANDARD_CONTRACT: P4
      P2_STAGE_STANDARD_CONTRACT: P4
      P3_STAGE_STANDARD_CONTRACT: P4
      P4_STAGE_STANDARD_CONTRACT: P4
      domain_count_does_not_override_contract_class: true
    p4_execution_requires_standard_or_skeleton_root: true
    business_case_is_record_classify_route_only_for_p4: true
  impact_graph:
    predicted_required_before_candidate_dispatch: true
    verified_assembled_from_p3_graphs_and_exact_p2_facts: false
    edge_source_reference_and_hash_required: true
    ai_inferred_edge_is_hypothesis_only: false
    unresolved_edge_blocks_plan_approval: true
    scope_change_requires_reinspect_replan_reapprove: true
    verified_assembled_from_exact_contract_rule_hash_delta_and_governed_dependency_facts: true
    ai_inferred_edge_forbidden: true
    unchanged_hash_nodes_preserved_without_reexecution: true
  coordination_plan:
    deterministic_inputs:
    - immutable_change_set
    - verified_standard_skeleton_impact_graph
    - versioned_policy
    required_semantics:
    - activation_plan_ref
    - activation_plan_hash
    - change_set_ref
    - verified_impact_graph_ref
    - ordered_step_refs
    - compensation_plan_ref
    - recovery_policy_ref
    topological_order_and_cycle_free: true
    immutable_after_approval: true
    trial_evaluation_final_order: true
    plan_change_requires_new_ref_hash_and_approval: true
  domain_step_mapping:
    REQUEST_CANDIDATE: request_candidate
    TRIAL_ACTIVATION: request_activation
    EVALUATION_WAIT: read_receipt
    FINAL_ACTIVATION: request_activation
    ROLLBACK: request_rollback
    COMPENSATION: request_rollback
    READ_RECEIPT: read_receipt
    each_domain_mutation_maps_to_exactly_one_p3_method: true
    p4_direct_domain_mutation_forbidden: true
  trial_coordination:
    p3_owns_trial_and_evaluation_semantics: true
    p4_waits_for_p3_evaluation_receipt: true
    p4_recomputation_of_p3_evaluation_forbidden: true
    final_activation_requires_evaluation_ref_when_trial_required: true
    ADJUST_creates_new_candidate_and_plan: true
    ROLLBACK_routes_to_compensation_or_rollback: true
    ESCALATE_requires_reinspection: true
saga:
  state_model:
    states:
    - PROPOSED
    - IMPACT_READY
    - EXECUTING
    - CANDIDATES_READY
    - VALIDATED
    - PLAN_APPROVED
    - ACTIVE
    - RECOVERY_REQUIRED
    - ROLLED_BACK
    - FROZEN
    execution_phases:
    - CANDIDATE
    - TRIAL_ACTIVATION
    - EVALUATION_WAIT
    - FINAL_ACTIVATION
    - COMPENSATION
    - ROLLBACK
    transitions:
    - PROPOSED -> IMPACT_READY
    - IMPACT_READY -> EXECUTING(CANDIDATE)
    - EXECUTING(CANDIDATE) -> CANDIDATES_READY | RECOVERY_REQUIRED
    - CANDIDATES_READY -> VALIDATED | IMPACT_READY
    - VALIDATED -> PLAN_APPROVED
    - PLAN_APPROVED -> EXECUTING(TRIAL_ACTIVATION | FINAL_ACTIVATION)
    - EXECUTING(TRIAL_ACTIVATION) -> EXECUTING(EVALUATION_WAIT | COMPENSATION) | RECOVERY_REQUIRED
    - EXECUTING(EVALUATION_WAIT) -> EXECUTING(FINAL_ACTIVATION | COMPENSATION) | IMPACT_READY | RECOVERY_REQUIRED
    - EXECUTING(FINAL_ACTIVATION) -> ACTIVE | EXECUTING(COMPENSATION) | RECOVERY_REQUIRED
    - ACTIVE -> EXECUTING(ROLLBACK)
    - EXECUTING(COMPENSATION | ROLLBACK) -> ROLLED_BACK | RECOVERY_REQUIRED
    - RECOVERY_REQUIRED -> EXECUTING(declared_phase) | FROZEN
    active_is_stable_nonterminal: true
    rolled_back_and_frozen_are_terminal: true
    undeclared_transition_fail_closed: true
  journal:
    append_only_hash_chained: true
    required_semantics:
    - sequence
    - previous_entry_hash
    - entry_hash
    - change_set_ref
    - state_before
    - state_after
    - execution_phase
    - step_ref
    - request_hash
    - provider_receipt_ref
    - coordination_receipt_ref
    - recovery_cursor
    - recorded_at
    canonical_serialization_and_sha256_required: true
    fork_gap_rewrite_or_hash_mismatch_rejected: true
  recovery_cursor:
    monotonic: true
    required_semantics:
    - execution_phase
    - step_index
    - target_step_ref
    - last_verified_journal_hash
    - last_provider_receipt_ref
    advance_requires_verified_journal_and_provider_evidence: true
    regression_or_skip_forbidden: true
  restart_recovery:
    reconstructs_exact_next_safe_action_from_state_journal_cursor_receipts_lease_and_fencing: true
  compensation:
    reverse_successful_activation_order: true
    successful_provider_receipt_required: true
    complete_state_rollback_target_required: true
    irreversible_migration_uses_approved_forward_recovery: true
    silent_best_effort_forbidden: true
    failed_compensation_routes_to_recovery_required: true
  freeze:
    allowed_from: RECOVERY_REQUIRED
    operator_authority_policy_journal_lease_fencing_and_receipt_required: true
standard_upgrade_coevolution:
  purpose: Create and enrich one immutable P4 Case for every governed Contract CURRENT transition, then coordinate execution only when the root
    Contract is Meta or a P0-P4 Standard/Skeleton Contract; business roots route to P3.
  implementation_claimed: false
  automatic_case_creation_claimed: false
  case_initiation: automatic_governed_case_creation_on_exact_registered_contract_transition_when_runtime_implementation_exists
  required_input_semantics:
  - upgraded_stable_contract_q_id
  - previous_exact_contract_ref
  - previous_contract_hash
  - current_exact_contract_ref
  - current_contract_hash
  - root_contract_class
  - reverse_dependency_fact_set_ref
  - reverse_dependency_fact_set_hash
  dependency_fact_requirements:
    facts_come_from_current_registered_consumer_dependency_projection: true
    each_fact_targets_upgraded_stable_contract_q_id: true
    each_fact_preserves_resolved_target_contract_ref_at_source_registration: true
    direct_q_standard_database_access_forbidden: true
    facts_must_arrive_as_governed_impact_input: true
    file_scan_numeric_version_guess_or_git_search_as_authority_forbidden: true
  analysis:
    direct_current_consumers_seed_impact_scope: true
    target_current_and_consumer_registration_baseline_are_compared: true
    mechanical_successor_for_every_consumer_forbidden: true
    unaffected_consumer_may_keep_current_version: true
    transitive_scope_expansion_requires_verified_impact: true
    affected_contract_change_routes_through_existing_p3_p4_governed_evolution_coordination: true
    p4_direct_contract_mutation_forbidden: true
    hash_equal_rule_or_leaf_requires_no_rewrite: true
    business_root_routes_to_p3_even_when_multiple_domains_are_affected: true
    standard_or_skeleton_root_executes_in_p4_even_when_only_one_domain_is_affected: true
  tenant_boundary:
    tenant_contract_default_included: false
    explicit_opt_in_required: true
    only_governed_opt_in_participation_facts_may_enter_case: true
    opt_in_is_impact_analysis_participation_not_authority_transfer: true
    tenant_contract_semantic_authority_remains_tenant_owned: true
    p4_direct_tenant_contract_mutation_forbidden: true
  automatic_case_creation_required: true
  pre_impact_enrichment:
    q_standard_rule_delta_required: true
    q_prompt_artifact_required: true
    changed_leaf_hash_set_required_before_targeted_materialization_receipt_closure: true
    required_refs_and_hashes:
    - rule_delta_ref
    - rule_delta_hash
    - q_prompt_artifact_ref
    - q_prompt_artifact_hash
    - changed_leaf_hash_set_ref
    - changed_leaf_hash_set_hash
    missing_required_enrichment_blocks_impact_plan: true
