projection:
  source_contract_ref: Q.SS.STD.P3.CONTRACT.EVOLUTION@V0144
  semantic_authority: false
  projection_only: true
object_model:
  hierarchy:
  - DOMAIN
  - CAPABILITY
  - OPERATION
  domain_ref: q.p3.domain.domain_evolution
  capability_ref: q.p3.capability.governed_evolution
  operation_ids:
  - inspect_change
  - create_candidate
  - validate_candidate
  - approve_candidate
  - activate_candidate
  - evaluate_candidate
  - rollback_candidate
  - read_receipt
  coordination_port_ref: q.p3.port.coordination_contract
  module_object_forbidden: true
  local_parent_identity_must_resolve: true
  interface_is_operation_owned_formal_object_not_hierarchy_level: true
  port_is_binding_object_not_business_hierarchy_level: true
lifecycle:
  formal_operations:
  - inspect_change
  - create_candidate
  - validate_candidate
  - approve_candidate
  - activate_candidate
  - evaluate_candidate
  - rollback_candidate
  - read_receipt
  states:
  - OBSERVED
  - PROPOSED
  - CANDIDATE_CREATED
  - VALIDATED
  - APPROVED
  - WAITING_FOR_P4
  - TRIAL_ACTIVE
  - EFFECT_EVALUATED
  - ACTIVE
  - ROLLED_BACK
  transition_order:
  - OBSERVED -> PROPOSED
  - PROPOSED -> CANDIDATE_CREATED
  - CANDIDATE_CREATED -> VALIDATED
  - VALIDATED -> APPROVED | WAITING_FOR_P4
  - APPROVED | WAITING_FOR_P4 -> TRIAL_ACTIVE | ACTIVE
  - TRIAL_ACTIVE -> EFFECT_EVALUATED
  - EFFECT_EVALUATED -> ACTIVE | ROLLED_BACK | CANDIDATE_CREATED | WAITING_FOR_P4
  outcomes:
  - RETAIN
  - ADJUST
  - ROLLBACK
  - ESCALATE
  invariants:
    direct_activation_only_when_trial_not_required: true
    trial_pointer_separate_from_active_pointer: true
    active_pointer_unchanged_during_trial: true
    pointer_mutation_uses_cas: true
    mutation_guarded_idempotent_atomic_and_receipted: true
    adjust_creates_new_candidate_lineage: true
    irreversible_migration_requires_forward_recovery_plan: true
    active_is_stable_non_terminal: true
    rolled_back_is_terminal: true
    validation_precedes_approval: true
    active_state_exact_capability_contract_refs_and_hashes_required: true
    capability_pass_does_not_replace_domain_composition_validation: true
candidate_domain_state:
  complete_state_not_patch: true
  component_kinds_closed:
  - BUSINESS_OBJECT
  - ITEM
  - FIELD
  - SCHEMA
  - INTERFACE
  - CONTRACT
  - POLICY
  - CONFIGURATION
  - IMPLEMENTATION
  - PUBLICATION
  - DEPENDENCY
  - DATA
  - DEPLOYMENT
  - SECURITY_CONTROL
  applicable_component_required_semantics:
  - kind
  - versioned_ref
  - content_hash
  - owner_ref
  - compatibility_status
  - owner_preparation_receipt_ref
  non_applicable_kind_requires_reason: true
  p3_composes_and_verifies_but_does_not_absorb_owner_authority: true
  capability_contract_composition_required: true
  capability_contract_map_entry_required:
  - capability_ref
  - capability_contract_ref
  - capability_contract_content_hash
  - compatibility_status
  moving_current_alias_inside_activated_domain_state_forbidden: true
capability_granular_evolution:
  capability_semantic_change_authority: owning Domain P3
  one_capability_contract_may_change_independently: true
  candidate_output_remains_complete_domain_state_not_patch: true
  domain_state_capability_map_required: true
  domain_state_capability_map_entry:
  - capability_ref
  - capability_contract_ref
  - capability_contract_content_hash
  - compatibility_status
  unchanged_capabilities_preserve_exact_refs_and_hashes: true
  changed_capability_requires_successor_capability_contract: true
  cross_capability_dependency_and_compatibility_revalidated_before_activation: true
  multi_domain_impact_routes_to_p4: false
  capability_contract_content_hash_is_external_exact_artifact_binding: true
  self_hash_literal_from_capability_contract_source_forbidden: true
  candidate_domain_state_must_resolve_all_capability_hashes_before_validation: true
  operation_semantic_change_is_expressed_in_owning_capability_contract_successor: true
  operation_level_impact_targeting_required: true
  multi_domain_business_impact_uses_p2_propagation_and_independent_p3: true
  p4_case_exists_for_every_contract_transition_but_business_execution_routes_to_p3: true
  unchanged_capability_operation_and_leaf_hashes_are_reused: true
