{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": true,
  "properties": {
    "content_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "domain_refs": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "impact_graph_ref": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "unresolved": {
      "type": "boolean"
    }
  },
  "required": [
    "impact_graph_ref",
    "content_hash"
  ],
  "title": "P3 Impact Graph Reference",
  "type": "object"
}
