authority:
  capability_contract_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.DOMAIN_INSTANTIATION@V0114
  semantic_authority: false
capability_model:
  purpose: deterministically instantiate one P2-delivered active Contract into a P2-realized target repository without AI in steady state
  execution_mode: STEADY_STATE_NON_AI
  public_external_surface: false
  entry_operation_id: instantiate_repository
  cross_domain_connections_realized_only_by_p2_consumer: true
  same_domain_child_planning_call_uses_p1_internal_call: true
deterministic_instance_automation:
  execution_mode: STEADY_STATE_NON_AI
  entry_operation: instantiate_repository
  steady_state_source_acquisition: activated_contract_material via P1 dependency_invoke after P2.Consumer realization
  internal_chain_order:
  - compile_contract
  - build_instance_plan
  - materialize_repository
  - verify_instance
  repository_materialization_path: repository_materialization via P1 dependency_invoke after P2.Consumer realization
  repository_readback_path: repository_readback via P1 dependency_invoke after P2.Consumer realization
  legacy_lower_level_operations_remain_callable: true
  build_instance_plan_is_facade_over_child_capability: true
  semantic_authority_preserved: true
  caller_preassembled_governed_inputs_required: false
  model_or_llm_required: false
  model_or_llm_call_inside_chain_forbidden: true
  q_prompt_artifact_required_for_steady_state_execution: false
  direct_cross_domain_access_forbidden: true
  adapter_or_translation_intermediary_forbidden: true
  fail_closed_conditions:
  - activated Contract binding is unresolved not selected-active unsupported or integrity-invalid
  - target repository dependency or repository readback dependency is not exactly realized by P2.Consumer
  - target repository cannot be resolved or provisioned under the exact bound Provider Interface
  - target base revision changes after freeze and before commit
  - governed CURRENT authority snapshot is incomplete inconsistent or stale
  - required Stage physical projection template path variable or binding input is unresolved
  - child build_instance_plan exact authority or interface cannot be resolved
  - any step would require model inference semantic invention Adapter translation or direct repository-content inference
  - materialized repository bytes or file set do not reproduce the exact Instance Plan
execution_pipeline: {}
target_repository_boundary:
  target_repository_is_execution_destination_not_semantic_authority: true
  target_repository_requirement_is_provider_neutral: true
  github_is_supported_as_a_future_bound_provider_not_hardcoded_here: true
  repository_provider_exact_identity_and_interfaces_are_selected_by_p2_binding: true
  repository_may_be_created_if_absent_only_by_the_bound_provider_contract: true
  existing_repository_bytes_may_be_read_only_for_hash_delta_concurrency_and_verification: true
  business_semantics_must_not_be_inferred_from_existing_repository: true
  exact_base_revision_freeze_required_before_write: true
  base_revision_mismatch_fails_closed: true
  writes_only_from_exact_instance_plan: true
  write_scope_must_remain_inside_resolved_repository_root: true
  resulting_repository_revision_identity_required: true
  readback_of_exact_resulting_revision_required: true
  large_or_opaque_byte_transport_may_use_governed_artifact_material_after_binding: true
  artifact_byte_transport_is_not_second_semantic_interface: true
  repository_commit_or_provider_receipt_is_integrity_fact_not_business_semantic_authority: true
  code_byte_determinism_is_owned_by_exact_instance_plan_not_by_provider_generated_commit_identity: true
  publication_deployment_activation_or_gate_verdict_not_owned: true
cross_domain_connection_boundary:
  connection_mode: CROSS_DOMAIN
  authority_ref: Q.SS.STD.P2.CONTRACT.CROSS_DOMAIN_REALIZATION@${CURRENT}
  source_contract_ingress: source_domain.P2.Provider.governed_data_exposure -> q_template.P2.Consumer.governed_data_consumption -> q_template.P2.Consumer.p1_dependency_realization
    -> q_template.P1 dependency_invoke
  repository_capability_realization: repository_service_domain.P2.Provider.capability_publishing -> q_template.P2.Consumer.external_capability_mounting -> q_template.P2.Consumer.p1_dependency_realization
    -> q_template.P1 dependency_invoke
  p2_provider_consumer_roles_not_implemented_inside_p1: true
  exact_provider_q_interface_identity_request_response_stable_error_outcome_preserved: true
  direct_q_template_p1_to_foreign_provider_bypass_forbidden: true
  direct_cross_domain_database_drive_github_api_or_repository_bypass_forbidden: true
  adapter_bridge_wrapper_translation_mapping_gateway_or_second_protocol_forbidden: true
capability_rules:
  operation_count: 5
  interface_count: 5
  minimum_operation_count_satisfied: true
  every_operation_owned_by_exact_capability: true
  every_interface_owned_by_capability_operation: true
  request_response_stable_error_closure_explicit: true
  every_dependency_explicit_and_classified: true
  cross_domain_dependency_realization_owned_by_p2: true
  p2_dependency_creation_forbidden: true
  upstream_contract_ingress_must_use_exact_p2_realized_dependency: true
  downstream_repository_egress_must_use_exact_p2_realized_dependency: true
  steady_state_ai_or_model_call_forbidden: true
  development_ai_test_double_may_not_be_semantic_authority_or_runtime_dependency: true
  adapter_or_alternate_connection_mode_forbidden: true
  exact_instance_plan_required_before_repository_write: true
  exact_resulting_repository_revision_readback_required: true
  new_q_wide_field_surface_kind_layer_stage_or_module_created: false
forbidden:
- exact owner Domain Contract version or content-hash pin
- exact build_instance_plan child version or content-hash pin
- direct handler import or custom internal HTTP API bypass
- direct Q.Template P1 read scan query of a foreign Domain P1 implementation
- direct Q.Template P1 use of GitHub API Drive API database query or repository transport as a cross-domain semantic path
- Adapter bridge wrapper translation mapping gateway or second protocol inside any governed Q connection path
- caller-supplied final target file content as substitute for child plan compilation
- caller-preassembled CURRENT locator template authority or binding set as a mandatory steady-state input
- business-semantic inference from existing target repository bytes
- repository write before exact Instance Plan closure
- repository write without exact P2-realized repository_materialization dependency binding
- successful instantiate_repository result before repository_readback closes exact repository revision file set and byte hashes
- LLM model AI interpretation inside steady-state chain
- AI test harness model or mock provider used as semantic authority production provider authority or production runtime dependency
- business-semantic invention beyond exact activated input Contract
- Q.Prompt as mandatory steady-state runtime dependency
- silent fallback when authority template binding path repository dependency or interface resolution is incomplete
- instance-local payload grammar extension
- direct AI implementation mutation without an exact bound Q.Prompt Prompt Artifact for this Contract
acceptance:
- owner Domain and child build_instance_plan resolve through stable CURRENT refs without exact child version or hash embedding
- all five Domain Instantiation Operation identities are preserved and no additional Operation is introduced in V0114
- all five Operation Interfaces are explicit M1 CALL_INVOKE projections with complete disjoint PATH STATIC_MOUNT DYNAMIC_MOUNT fields from the current Field Dictionary
- steady-state source Contract enters only through activated_contract_material predeclared P1 dependency realized by P2.Consumer and must prove exact selected-active
  identity hash bytes and provenance
- compile_contract recomputes and verifies exact input Contract integrity before semantic use
- build_instance_plan delegates only through P1 internal_call to BUILD_INSTANCE_PLAN and never directly implements child planning semantics
- repository materialization uses only repository_materialization predeclared P1 dependency realized by P2.Consumer and never hardcodes GitHub or another repository
  provider
- a future GitHub repository Provider may create the repository and write exact planned bytes without changing Q.Template Contract semantics
- repository verification uses only repository_readback predeclared P1 dependency realized by P2.Consumer and verifies the exact resulting revision
- target repository state is used only for base-revision concurrency hash delta and verification never for business semantic inference
- P2 Provider Consumer roles remain outside this P1 Capability and only realize its predeclared local dependency slots
- development AI may operate a test provider double or assist mounting only outside steady-state runtime and under the exact same Q Interface contracts; it is never
  an Adapter or authority
- production steady-state execution requires no AI LLM or Q.Prompt
- no Gate PASS Activation publication deployment or runtime ACTIVE status is implied
- implementation code generation for this Capability requires a Q.Prompt Prompt Artifact compiled from this exact ACTIVE Contract and frozen Q.Standard Rule snapshot
  before any AI repository materialization
