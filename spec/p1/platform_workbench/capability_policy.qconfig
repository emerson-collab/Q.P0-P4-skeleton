public_boundary_policy:
  source_authority: exact Capability Contract external_provider_surface
  code_scan_or_inference_forbidden: true
  public_collection_expansion_beyond_verified_surface_forbidden: true
  direct_handler_export_forbidden: true
  inferred_public_api_forbidden: true
dependency_closure_policy:
  dependency_kinds:
  - RECEIVING_DOMAIN_DEPENDENCY
  - PUBLIC_CONTRACT_DEPENDENCY
  - STANDARD_AUTHORITY_DEPENDENCY
  - PROVIDER_INTERNAL_DEPENDENCY
  each_dependency_classified_exactly_once: true
  dependency_refs_equal_classification_union: true
  every_dependency_exact_and_versioned: true
  implicit_dependency_forbidden: true
  circular_dependency_forbidden: true
compatibility_policy:
  capability_contract_version_equals_capability_version: true
  exact_capability_contract_ref_and_hash_required: true
  unresolved_hash_forbidden: true
source_integrity_policy:
  capability_contract_content_hash_required_sha256_binding: true
  hash_must_equal_external_exact_artifact_binding: true
  external_provider_surface_ref_required_exact: true
  external_provider_surface_hash_required_sha256_binding: true
  source_integrity_ref_required: true
