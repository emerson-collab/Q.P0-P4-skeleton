  source_ref: Q.UI.CONTRACT.CAPABILITY.UI_SURFACE@V0111#/dependencies/external_dependencies/presentation_context/allowed_candidates/application
  realization_owner: Q.SS.STD.P2.CONTRACT.CROSS_DOMAIN_REALIZATION@V0123
  p1_provider_implementation_forbidden: true
- requirement_id: platform
