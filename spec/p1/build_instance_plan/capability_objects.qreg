authority:
  capability_contract_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105
  semantic_authority: false
identity:
  capability_ref: Q.TEMPLATE.CAPABILITY.BUILD_INSTANCE_PLAN@V0105
  capability_id: build_instance_plan
  capability_version: V0105
  capability_contract_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105
  contract_version_equals_capability_version: true
  one_exact_contract_for_this_capability_version: true
  capability_contract_integrity_binding_ref: Q.TEMPLATE.CONTRACT.DOMAIN@V0120#/capability_composition/build_instance_plan
operations:
  build_instance_plan:
    operation_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/operations/build_instance_plan
    semantic_role: DETERMINISTIC_INSTANCE_PLAN_ORCHESTRATION
    requires:
    - COMPILED_CONTRACT
    produces: EXACT_INSTANCE_PLAN
    primary_interface_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/interfaces/build_instance_plan_invoke
    requirements:
    - invoke the six internal suboperations strictly in execution_pipeline.internal_suboperation_order
    - allow execution from COMPILED_CONTRACT alone by obtaining selected authority material through the exact predeclared P1 dependency slot and resolving Q.Template-owned
      templates locally
    - if legacy exact governed inputs are supplied validate them and use them only as governed resolution material not as business semantic authority
    - pass only standard interface envelope fields plus owner-local schema-bound input payload
    - return only after exact Instance Plan closure is verified
    - fail closed without invoking AI bypassing P1 dependency_invoke or bypassing an internal interface
    optional_legacy_governed_inputs:
    - GOVERNED_CURRENT_LOCATOR_STATE
    - GOVERNED_TEMPLATE_AUTHORITY_SET
    - EXPLICIT_GOVERNED_BINDING_INPUTS
    owner_capability_ref: Q.TEMPLATE.CAPABILITY.BUILD_INSTANCE_PLAN@V0105
  resolve_authority_snapshot:
    operation_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/operations/resolve_authority_snapshot
    semantic_role: GOVERNED_CURRENT_AUTHORITY_RESOLUTION
    requires:
    - COMPILED_CONTRACT
    produces: EXACT_AUTHORITY_SNAPSHOT
    primary_interface_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/interfaces/resolve_authority_snapshot_invoke
    requirements:
    - derive all stable CURRENT references required by the compiled Contract and applicable Meta and P0-P4 authorities
    - invoke only the predeclared governed_current_authority_material local dependency through the current P1 dependency_invoke framework interface when selected-state
      material is not already present as an exact governed legacy input
    - require P2.Consumer realization of that dependency before any cross-domain authority material is consumed
    - resolve every required stable CURRENT reference from Q_STANDARD_SELECTED_ACTIVE_POINTER material to one exact Contract ref and SHA-256
    - preserve Q.Standard as selected-state locator authority rather than semantic authority
    - forbid direct Q.Standard database Drive repository or foreign-P1 reads from this P1 Operation
    - fail closed on unresolved duplicate inconsistent stale inactive or integrity-invalid authority
    optional_legacy_governed_inputs:
    - GOVERNED_CURRENT_LOCATOR_STATE
    owner_capability_ref: Q.TEMPLATE.CAPABILITY.BUILD_INSTANCE_PLAN@V0105
  resolve_physical_manifest:
    operation_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/operations/resolve_physical_manifest
    semantic_role: EXACT_PHYSICAL_PROJECTION_RESOLUTION
    requires:
    - COMPILED_CONTRACT
    - EXACT_AUTHORITY_SNAPSHOT
    produces: EXACT_PHYSICAL_MANIFEST
    primary_interface_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/interfaces/resolve_physical_manifest_invoke
    requirements:
    - derive target file paths from both Contract-declared physical semantics and the exact selected P0-P4 Stage physical authorities in EXACT_AUTHORITY_SNAPSHOT
    - include every required fixed Stage skeleton file and every Contract-owned variable projection file required by those exact authorities
    - forbid inferred relocated convenience or undeclared paths
    - preserve exact Stage physical closure
    owner_capability_ref: Q.TEMPLATE.CAPABILITY.BUILD_INSTANCE_PLAN@V0105
  resolve_template_set:
    operation_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/operations/resolve_template_set
    semantic_role: GOVERNED_TEMPLATE_RESOLUTION
    requires:
    - EXACT_PHYSICAL_MANIFEST
    - EXACT_AUTHORITY_SNAPSHOT
    produces: EXACT_TEMPLATE_SET
    primary_interface_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/interfaces/resolve_template_set_invoke
    requirements:
    - resolve exactly one governed template identity content hash and bytes for every renderable manifest file role from Q.Template-owned governed template authority
    - select templates only by governed profile role and exact authority bindings
    - forbid raw-newest numeric-highest filesystem-order AI-selected or foreign-provider-selected templates
    - fail closed when zero or more than one eligible exact template remains
    optional_legacy_governed_inputs:
    - GOVERNED_TEMPLATE_AUTHORITY_SET
    owner_capability_ref: Q.TEMPLATE.CAPABILITY.BUILD_INSTANCE_PLAN@V0105
  resolve_binding_set:
    operation_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/operations/resolve_binding_set
    semantic_role: EXACT_BINDING_RESOLUTION
    requires:
    - COMPILED_CONTRACT
    - EXACT_PHYSICAL_MANIFEST
    - EXACT_TEMPLATE_SET
    produces: EXACT_BINDING_SET
    primary_interface_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/interfaces/resolve_binding_set_invoke
    requirements:
    - bind every template variable first to one exact Contract fact and otherwise to one exact governed Binding Declaration carried in the exact activated Contract
      closure or exact governed legacy input
    - preserve Capability Instance and Binding Declaration authority boundaries
    - forbid inferred default provider port policy secret instance identity or business semantic value
    - forbid direct cross-domain binding lookup from this P1 Operation unless a future successor predeclares a dedicated dependency slot
    - fail closed on unresolved ambiguous or undeclared binding input
    optional_legacy_governed_inputs:
    - EXPLICIT_GOVERNED_BINDING_INPUTS
    owner_capability_ref: Q.TEMPLATE.CAPABILITY.BUILD_INSTANCE_PLAN@V0105
  render_file_set:
    operation_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/operations/render_file_set
    semantic_role: DETERMINISTIC_TEMPLATE_RENDERING
    requires:
    - EXACT_TEMPLATE_SET
    - EXACT_BINDING_SET
    - EXACT_PHYSICAL_MANIFEST
    produces: EXACT_RENDERED_FILE_SET
    primary_interface_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/interfaces/render_file_set_invoke
    requirements:
    - render only governed template bytes plus exact resolved binding values
    - perform no LLM model AI code synthesis interpretation semantic completion or free-form repair
    - produce identical bytes for identical template hashes binding hashes authority snapshot and capability version
    - forbid unresolved template tokens
    owner_capability_ref: Q.TEMPLATE.CAPABILITY.BUILD_INSTANCE_PLAN@V0105
  compile_instance_plan:
    operation_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/operations/compile_instance_plan
    semantic_role: EXACT_INSTANCE_PLAN_FINALIZATION
    requires:
    - COMPILED_CONTRACT
    - EXACT_AUTHORITY_SNAPSHOT
    - EXACT_PHYSICAL_MANIFEST
    - EXACT_TEMPLATE_SET
    - EXACT_BINDING_SET
    - EXACT_RENDERED_FILE_SET
    produces: EXACT_INSTANCE_PLAN
    primary_interface_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/interfaces/compile_instance_plan_invoke
    requirements:
    - compute SHA-256 for every rendered target file
    - bind every file to exact template ref hash and binding-set hash
    - verify rendered file set equals exact physical manifest
    - compute deterministic replay identity
    - return final files mapping with content and SHA-256 already closed
    - fail closed on path template binding authority interface file-set or hash mismatch
    owner_capability_ref: Q.TEMPLATE.CAPABILITY.BUILD_INSTANCE_PLAN@V0105
ownership:
  domain_contract_ref: Q.TEMPLATE.CONTRACT.DOMAIN@V0120
  domain_contract_resolution_mode: EXACT_CURRENT_DOMAIN_COMPOSITION
  caller_capability_contract_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.DOMAIN_INSTANTIATION@V0114
  caller_facade_operation_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.DOMAIN_INSTANTIATION@V0114#/operations/build_instance_plan
  exact_parent_or_caller_version_pin_embedded: true
  exact_parent_or_caller_hash_pin_embedded: false
  stage_contract_ref: Q.SS.STD.P1.CONTRACT.BUSINESS_RUNTIME@${CURRENT}
  runtime_contract_ref: Q.SS.STD.P0.CONTRACT.RUNTIME_CORE@${CURRENT}
  domain_ref: q.p1.domain.q_template
dependencies:
  governed_current_authority_material:
    local_dependency_ref: q.template.build_instance_plan.governed_current_authority_material
    classification: CROSS_DOMAIN
    receiving_operation_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105#/operations/resolve_authority_snapshot
    p1_dependency_interface_ref: Q.SS.STD.P1.CONTRACT.BUSINESS_RUNTIME@${CURRENT}#/interfaces/dependency_invoke
    p2_consumer_authority_ref: Q.SS.STD.P2.CONTRACT.CROSS_DOMAIN_REALIZATION@${CURRENT}#/role_capability_catalog/consumer
    p2_governed_data_consumption_ref: Q.SS.STD.P2.CONTRACT.CROSS_DOMAIN_REALIZATION@${CURRENT}#/role_capability_catalog/consumer/capabilities/governed_data_consumption
    p1_dependency_realization_ref: Q.SS.STD.P2.CONTRACT.CROSS_DOMAIN_REALIZATION@${CURRENT}#/role_capability_catalog/consumer/capabilities/p1_dependency_realization
    consumer_to_receiving_p1_boundary_ref: Q.SS.STD.P2.CONTRACT.CROSS_DOMAIN_REALIZATION@${CURRENT}#/consumer_to_receiving_p1_boundary
    required_data_category: STATIC
    exact_active_binding_required: true
    direct_cross_domain_read_or_import_forbidden: true
  implicit_dependency_forbidden: true
  p2_creates_receiving_p1_dependency_forbidden: true
  p1_formal_dependency_on_p2_stage_forbidden: true
