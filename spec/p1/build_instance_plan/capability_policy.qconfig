authority:
  capability_contract_ref: Q.TEMPLATE.CONTRACT.CAPABILITY.BUILD_INSTANCE_PLAN@V0105
  semantic_authority: false
capability_model:
  purpose: deterministically compile one governed compiled business Contract into an exact repository Instance Plan while internally resolving governed authority
    template and binding inputs
  execution_mode: STEADY_STATE_NON_AI
  public_external_surface: false
  same_domain_only: true
  facade_owned_by: Q.TEMPLATE.CONTRACT.CAPABILITY.DOMAIN_INSTANTIATION@${CURRENT}#/operations/build_instance_plan
  entry_operation_id: build_instance_plan
  result_role: EXACT_INSTANCE_PLAN
  caller_preassembly_required: false
deterministic_instance_automation: {}
execution_pipeline:
  order:
  - build_instance_plan
  - resolve_authority_snapshot
  - resolve_physical_manifest
  - resolve_template_set
  - resolve_binding_set
  - render_file_set
  - compile_instance_plan
  entry_operation: build_instance_plan
  internal_suboperation_order:
  - resolve_authority_snapshot
  - resolve_physical_manifest
  - resolve_template_set
  - resolve_binding_set
  - render_file_set
  - compile_instance_plan
  internal_suboperation_calls_use_p1_internal_call: true
  direct_handler_chaining_forbidden: true
  reordering_forbidden: true
  partial_plan_acceptance_forbidden: true
  steady_state_model_or_llm_call_forbidden: true
  q_prompt_runtime_dependency_forbidden: true
target_repository_boundary: {}
cross_domain_connection_boundary: {}
capability_rules:
  operation_count: 7
  interface_count: 7
  minimum_operation_count_satisfied: true
  every_operation_owned_by_exact_capability: true
  every_interface_owned_by_capability_operation: true
  request_response_stable_error_closure_explicit: true
  every_dependency_explicit_and_classified: true
  cross_domain_dependency_realization_owned_by_p2: true
  p2_dependency_creation_forbidden: true
  steady_state_ai_or_model_call_forbidden: true
  adapter_or_alternate_connection_mode_forbidden: true
  exact_instance_plan_required_before_repository_write: true
  new_q_wide_field_surface_kind_layer_stage_or_module_created: false
forbidden:
- new P5 or alternative Stage creation
- target Stage generator Capabilities that duplicate P0 P1 P2 P3 P4 ownership
- caller-preassembled CURRENT locator template authority or binding sets as mandatory steady-state inputs
- direct cross-domain read lookup scan database query Drive read repository read or foreign-P1 introspection from this P1 Capability
- P2 Provider Consumer implementation inside this P1 Capability
- Adapter bridge wrapper translation mapping gateway or second protocol inside any governed Q connection path
- final target file content supplied as opaque caller-authored generation result
- AI LLM model or Q.Prompt invocation in steady-state plan compilation
- semantic inference from prose when exact Contract field or governed binding is absent
- template selection by newest file numeric-highest version filesystem order or AI choice
- path inference outside Contract and selected Stage physical authority
- direct target repository writes from this Capability
- direct handler chaining between Operations
- owner-local payload schema used to expand Q-wide field catalog
- instance-local payload grammar extension
- Q.Gate verdict activation publication deployment or runtime ACTIVE claim
- direct AI implementation mutation without an exact bound Q.Prompt Prompt Artifact for this Contract
acceptance:
- build_instance_plan remains one Q.Template P1 Capability and does not create a new Stage or sibling planning Capability
- all seven existing Operation identities are preserved and no new Operation is added inside BUILD_INSTANCE_PLAN
- Domain parent and caller Capability resolve this child only through stable CURRENT identity
- resolve_authority_snapshot consumes selected-state authority material only through the predeclared P1 dependency slot realized by P2.Consumer or an exact governed
  legacy input
- no BUILD_INSTANCE_PLAN Operation directly reads Q.Standard another Domain P1 database Drive or repository state
- entry build_instance_plan can execute from COMPILED_CONTRACT without caller-preassembled CURRENT template or binding sets
- all seven CALL Interfaces use M1 CALL_INVOKE and complete disjoint PATH STATIC_MOUNT DYNAMIC_MOUNT field sets from the current Field Dictionary including input
  in DYNAMIC_MOUNT
- all six deterministic suboperations execute in declared order through standard P1 internal-call interfaces
- resolve_physical_manifest combines Contract physical semantics with selected P0-P4 Stage physical authorities and preserves exact Stage closure
- resolve_template_set obtains exactly one Q.Template-governed template per renderable manifest role without newest or AI selection
- resolve_binding_set closes every token from exact Contract facts or governed Binding Declaration material without inferred defaults
- exact Instance Plan contains final bytes and hashes before materialize_repository
- identical replay identity inputs produce byte-identical Instance Plans
- any unresolved authority path template binding interface token or hash condition fails closed without AI fallback
- no Q.Gate PASS activation publication deployment or runtime ACTIVE status is implied
- implementation code generation for this Capability requires a Q.Prompt Prompt Artifact compiled from this exact ACTIVE Contract and frozen Q.Standard Rule snapshot
  before any AI repository materialization
