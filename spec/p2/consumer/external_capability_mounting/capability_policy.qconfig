projection:
  source_contract_ref: Q.SS.STD.P2.CONTRACT.CROSS_DOMAIN_REALIZATION@V0118
  role: consumer
  capability_id: external_capability_mounting
rules:
  operation_set_exact:
  - consume_publication
  - create_mount
  - activate_mount
  - rollback_mount
  - execute_mounted_capability
  operation_count: 5
  cross_domain_direct_p1_read_forbidden: true
  protocol_translation_mapping_wrapper_second_protocol_forbidden: true
  new_global_field_surface_layer_interface_kind_forbidden: true
  p2_stage_database_ownership_forbidden: true
  fact_persistence_owner_rule: "every persisted publication/mount/binding/receipt/data-consumption fact resolves to the exact implementing Q Domain owner through that Domain persistence_contract"
  cross_domain_sql_business_dependency_forbidden: true
  cross_owner_foreign_key_forbidden: true
  p2_evidence_observation_gate_activation_authority_forbidden: true
  stage_local_workflow_launcher_forbidden: true
  local_p0_is_only_runtime_when_execution_required: true
  exact_source_and_test_leaf_per_operation_required: true
  unlisted_p2_path_forbidden: true
  verified_publication_required: true
  resolver_owner: P2.Consumer
  pointer_mutation_verify_then_atomic_last: true
  receiving_local_p0_only_execution_runtime: true
  executable_publication_requires_immutable_implementation_material_binding: true
  implementation_material_exact_artifact_ref_required: true
  implementation_material_exact_content_hash_required: true
  implementation_material_provider_neutral_locator_binding_required: true
  implementation_material_exact_entry_symbol_ref_required: true
  consume_publication_exact_artifact_verification_required: true
  create_mount_preserve_verified_resolver_state_required: true
  activate_mount_preserve_verified_resolver_state_required: true
  execute_exact_implementation_binding_to_local_p0_only: true
  implementation_binding_hash_receipt_required: true
